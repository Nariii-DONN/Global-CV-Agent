# ZERO-COST CORE — tuned for free public-web use
APP_HOST=127.0.0.1
APP_PORT=8787
DATABASE_PATH=./data/cv_agent.db
UPLOAD_DIR=./data/uploads
MAX_DOWNLOAD_MB=8
MAX_HTML_MB=3
MIN_MATCH_SCORE=0
FREE_SEARCH_ENABLED=1
FREE_SEARCH_DELAY=2.0

# Optional FREE local AI (recommended if you install Ollama locally)
# Leave OLLAMA_MODEL blank to use built-in deterministic extraction/scoring.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional paid/credited AI enhancement. NOT required.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional paid/credited search enhancement. NOT required (free tiers work).
# Serper ~2500/mo free, Brave ~2000/mo free — paste keys to 10x coverage, still $0.
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=

# Search limits. Increase slowly to avoid public-source rate limiting.
SEARCH_COUNTRY=IN
SEARCH_LANGUAGE=en
MAX_QUERIES_PER_JD=25
RESULTS_PER_QUERY=10
MAX_CANDIDATES_PER_RUN=60
MAX_AI_RERANK=30
FETCH_WORKERS=6
# Comma-separated hosts to skip fetching (login walls). Snippets still collected.
SKIP_FETCH_DOMAINS=linkedin.com,indeed.com,glassdoor.com,monster.com,ziprecruiter.com,facebook.com,instagram.com
LOG_LEVEL=INFO
